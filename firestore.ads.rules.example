// Fragmento para fusionar dentro de las reglas Firestore existentes de TaskFlow.
// NO reemplaza las reglas actuales del proyecto.

function adsSignedIn() {
  return request.auth != null;
}
function adsAdmin() {
  return adsSignedIn() && request.auth.token.taskflowAdsAdmin == true;
}
function adsOwner(userId) {
  return adsSignedIn() && request.auth.uid == userId;
}

match /users/{userId}/adsManager/{docId} {
  allow read: if adsOwner(userId) || adsAdmin();

  allow create: if adsOwner(userId)
    && request.resource.data.ownerUid == userId
    && request.resource.data.accountStatus == 'active';

  allow update: if adsAdmin() || (
    adsOwner(userId)
    && resource.data.ownerUid == userId
    && request.resource.data.ownerUid == userId
    && request.resource.data.accountStatus == resource.data.accountStatus
  );

  allow delete: if adsAdmin();
}

match /users/{userId}/adsCampaigns/{campaignId} {
  allow read: if adsOwner(userId) || adsAdmin();

  allow create: if adsOwner(userId)
    && request.resource.data.ownerUid == userId
    && request.resource.data.approvalStatus == 'pending'
    && request.resource.data.status in ['draft', 'active', 'paused']
    && request.resource.data.ads.size() >= 1
    && request.resource.data.ads.size() <= 12;

  allow update: if adsAdmin() || (
    adsOwner(userId)
    && resource.data.ownerUid == userId
    && request.resource.data.ownerUid == userId
    && request.resource.data.status in ['draft', 'active', 'paused']
    && request.resource.data.ads.size() >= 1
    && request.resource.data.ads.size() <= 12
    && (
      request.resource.data.approvalStatus == resource.data.approvalStatus
      || (
        resource.data.approvalStatus in ['approved', 'rejected']
        && request.resource.data.approvalStatus == 'pending'
      )
    )
  );

  allow delete: if adsOwner(userId) || adsAdmin();
}

match /adsPublicCampaigns/{campaignId} {
  allow read: if true;

  allow create, update: if adsAdmin() || (
    adsSignedIn()
    && request.resource.data.campaignId == campaignId
    && exists(/databases/$(database)/documents/users/$(request.auth.uid)/adsCampaigns/$(campaignId))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)/adsCampaigns/$(campaignId)).data.approvalStatus == 'approved'
    && get(/databases/$(database)/documents/users/$(request.auth.uid)/adsCampaigns/$(campaignId)).data.status == 'active'
  );

  allow delete: if adsAdmin() || (
    adsSignedIn()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid)/adsCampaigns/$(campaignId))
  );
}
